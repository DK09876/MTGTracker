[Unit]
Description=Snapshot the MTG Tracker database
After=mtg.service

[Service]
Type=oneshot
User=admin
# The release layout (scripts/DEPLOY.md): the script from the running release, the database from shared/.
WorkingDirectory=/home/admin/mtg/current
Environment=MTG_DB_PATH=/home/admin/mtg/shared/mtg.db
ExecStart=/home/admin/mtg/current/scripts/backup.sh --verify
