[Unit]
Description=Snapshot the MTG Tracker database
After=mtg.service

[Service]
Type=oneshot
User=admin
WorkingDirectory=/home/admin/development/MTGTracker
Environment=MTG_DB_PATH=/home/admin/development/MTGTracker/data/mtg.db
ExecStart=/home/admin/development/MTGTracker/scripts/backup.sh --verify
