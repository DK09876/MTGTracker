[Unit]
Description=Check MTG Tracker answers

[Service]
Type=oneshot
User=admin
# The release layout (scripts/DEPLOY.md): outages go beside the database, where the app reads them.
WorkingDirectory=/home/admin/mtg/current
Environment=MTG_OUTAGE_LOG=/home/admin/mtg/shared/outages.log
ExecStart=/home/admin/mtg/current/scripts/watch.sh
